{
  "ble": {
    "name": "PiBlue",
    "adapter": ""
  },
  "agent": {
    "log_level": "INFO",
    "min_interval_s": 1.0,
    "max_interval_s": 60.0
  },
  "auth": {
    "enabled": true,
    "token": "",
    "token_file": "/etc/piblue/token",
    "max_attempts": 5,
    "lockout_s": 60,
    "session_idle_s": 300
  },
  "shell": {
    "enabled": true,
    "allow_any": false,
    "allow_meta": false,
    "timeout_s": 10,
    "max_output_bytes": 8192
  },
  "control": {
    "enabled": true,
    "allow": [
      "reboot",
      "shutdown",
      "restart-agent",
      "restart-bluetooth",
      "wifi-enable",
      "wifi-disable",
      "wifi-scan",
      "wifi-connect",
      "wifi-disconnect",
      "disk-list",
      "disk-mount",
      "disk-unmount",
      "custom",
      "custom-save"
    ],
    "mount_root": "/mnt",
    "custom": [],
    "custom_timeout_s": 20,
    "allow_custom_edit": true,
    "custom_allow_meta": true
  },
  "sensors": {
    "onewire": true,
    "dht": [],
    "custom": []
  },
  "disk": {
    "path": "/"
  }
}
